{
  "manifest_version": 2,
  "name": "Os Reader",
  "version": "1.0",
  "description": "Reader mode for Os Browser (Mozilla Readability 0.6.0, Apache-2.0)",
  "browser_specific_settings": { "gecko": { "id": "reader@os.browser" } },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["Readability.js", "reader.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
