<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MultiBrowser" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/mb_accent</item>
        <item name="colorPrimaryDark">@color/mb_bg</item>
        <item name="colorAccent">@color/mb_accent</item>
        <item name="android:windowBackground">@color/mb_bg</item>
        <item name="android:statusBarColor">@color/mb_bg</item>
        <item name="android:navigationBarColor">@color/mb_bg</item>
        <item name="alertDialogTheme">@style/Theme.MultiBrowser.Dialog</item>
    </style>

    <style name="Theme.MultiBrowser.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/mb_accent</item>
        <item name="android:background">@color/mb_surface</item>
        <item name="android:textColorPrimary">@color/mb_text</item>
    </style>
</resources>
