---
// Журнал изменений: Android и Windows отдельными лентами, данные из релизов при сборке.
import Layout from '../../layouts/Layout.astro';
import { t, fmtDate, fmtSize } from '../../lib/i18n';
import { langPaths } from '../../lib/paths';
import { android, windows } from '../../lib/releases';
export const getStaticPaths = langPaths;
const { lang } = Astro.params;
const L = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const feeds = [['android', 'Android', android], ['windows', 'Windows', windows]] as const;
---
<Layout lang={lang} page="changelog" title={L('cl_title')} desc={L('cl_desc')}>
<div class="wrap page-head">
<h1 class="h1">{L('cl_title')}</h1>
<p class="lead">{L('cl_lead')}</p>
<div class="feeds">
{feeds.map(([id, name, p]) => <section class="feed" id={id} aria-labelledby={`h-${id}`}>
<h2 id={`h-${id}`}>{name}</h2>
{p ? p.releases.map((r) => <article class="rel">
<h3>{L('cl_build', { n: r.build })}{r.version && <> · {L('cl_version', { version: r.version })}</>}</h3>
<p class="muted"><time datetime={r.date}>{fmtDate(lang, r.date)}</time>{r.engine && <> · <span class="ltr">{r.engine}</span></>}</p>
{r.changes.length ? <ul lang="en" dir="ltr">{r.changes.map((c) => <li>{c}</li>)}</ul> : <p class="muted">{L('cl_none')}</p>}
<p class="links">{r.assets.filter((a) => !/\.aab$/.test(a.name)).map((a) => <a href={a.url} class="ltr">{a.name} ({fmtSize(lang, a.size)})</a>)}<a href={r.page}>{L('cl_page')}</a></p>
</article>) : <p class="muted">{L('dl_unavailable')}</p>}
</section>)}
</div>
<div class="pad-end"></div>
</div>
</Layout>
